rules_version = '2';
// 역전 Firestore 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙 에 그대로 붙여 넣고 [게시].
//   users/{uid}    내 저장(기록 · 출석 · 설정). 로그인한 본인만 읽고 쓴다
//   ranking/{uid}  전체 랭킹 한 줄. 누구나 읽고, 본인 줄만 정해진 모양으로 쓴다
//   rooms/{code}   온라인 대결 방. 로그인하면 읽고(코드로 찾기), 방장은 고치고, 다른 사람은 시작 전에 자기 자리만 넣고 뺀다
//   rooms/{code}/acts/{n}  방의 행동 기록. 방 사람만 읽고, 판이 시작된 뒤 자기 이름으로 새로 쓰기만(고치기 없음 · 지우기는 방장만)
// 점수는 기기에서 계산해 올리므로 마음먹고 고치면 막을 수 없다 — 터무니없는 값만 걸러 낸다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /ranking/{uid} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'hero', 'rp', 'total', 'plays', 'wins', 'updated'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 10
        && request.resource.data.hero is string && request.resource.data.hero.size() <= 24
        && request.resource.data.rp is int && request.resource.data.rp >= 0 && request.resource.data.rp <= 100000
        && request.resource.data.total is int && request.resource.data.total >= 0
        && request.resource.data.plays is int && request.resource.data.plays >= 0
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= request.resource.data.plays
        && request.resource.data.updated == request.time;
    }
    match /rooms/{code} {
      // 새 방 모양: 내가 방장이고 첫 자리
      function freshRoom() {
        let d = request.resource.data;
        return d.host == request.auth.uid && d.status == 'wait' && d.uids == [request.auth.uid]
          && d.seats.size() == 1 && d.seats[0].uid == request.auth.uid
          && d.size is int && d.size >= 2 && d.size <= 4 && d.board is string;
      }
      function joining() {
        return !(request.auth.uid in resource.data.uids)
          && request.resource.data.uids == resource.data.uids.concat([request.auth.uid]);
      }
      function leaving() {
        return request.auth.uid in resource.data.uids && !(request.auth.uid in request.resource.data.uids)
          && request.resource.data.uids.size() == resource.data.uids.size() - 1
          && resource.data.uids.hasAll(request.resource.data.uids);
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && freshRoom();
      allow delete: if request.auth != null && resource.data.host == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.status == 'gone' && freshRoom())
        || (resource.data.host == request.auth.uid && request.resource.data.host == resource.data.host
            && request.resource.data.size is int && request.resource.data.size <= 4
            && request.resource.data.size >= request.resource.data.uids.size())
        || (resource.data.status == 'wait' && request.resource.data.status == 'wait'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seats', 'uids', 'updated'])
            && request.resource.data.uids.size() <= resource.data.size
            && request.resource.data.seats.size() == request.resource.data.uids.size()
            && (joining() || leaving())));

      match /acts/{n} {
        function room() { return get(/databases/$(database)/documents/rooms/$(code)).data; }
        allow read: if request.auth != null && request.auth.uid in room().uids;
        allow delete: if request.auth != null && room().host == request.auth.uid; // 방장이 방을 치울 때
        allow create: if request.auth != null && request.auth.uid in room().uids && room().status == 'play'
          && request.resource.data.keys().hasOnly(['n', 'by', 'seat', 'a', 'v', 'h', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n >= 0
          && request.resource.data.a is string && request.resource.data.a.size() <= 10
          && (request.resource.data.v == null || (request.resource.data.v is string && request.resource.data.v.size() <= 4000))
          && request.resource.data.at == request.time;
      }
    }
  }
}
